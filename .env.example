# ─── Supabase (frontend + backend) ────────────────────────────────────────────
# Find these in Supabase → Project Settings → API

# Your Supabase project URL (safe to commit for non-sensitive projects)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The public anon key — designed by Supabase to be used in client-side code.
# Security is enforced by Row Level Security (RLS), not by keeping this secret.
# Do NOT use the service_role key here.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Supabase provides one under Project Settings
# → Database → Connection string. Use the Transaction pooler for serverless/edge.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ─── API Server ───────────────────────────────────────────────────────────────
# JWT secret used to verify Supabase tokens server-side.
# Find under: Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Random secret for session signing (32+ characters recommended)
SESSION_SECRET=replace-with-a-long-random-string

# ─── Object Storage (Google Cloud Storage / Replit Object Storage) ────────────
# The bucket ID for Replit Object Storage, or your GCS bucket name
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id

# GCS path prefix for private user uploads, e.g. /my-bucket/private
PRIVATE_OBJECT_DIR=/your-bucket/private

# Comma-separated GCS path prefixes for publicly accessible assets
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public
