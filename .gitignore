# ─── Compiled output ──────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
*.tsbuildinfo
.expo/
.expo-shared/

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Build artifacts ──────────────────────────────────────────────────────────
coverage/

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
.project
.classpath
.c9/
*.launch
.settings/

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Replit runtime ───────────────────────────────────────────────────────────
# .local contains the Replit dev environment (skills, tasks, etc.)
.local/
# .cache is Replit's internal build cache
.cache/

# ─── Agent memory ─────────────────────────────────────────────────────────────
# Development-session memory files used by the Replit AI agent
.agents/

# ─── Development assets ───────────────────────────────────────────────────────
# Files pasted into the workspace during development (not source code)
attached_assets/

# ─── Misc ─────────────────────────────────────────────────────────────────────
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings
.cursor/
.github/instructions/
